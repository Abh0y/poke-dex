datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Pokemon {
  id     Int    @id @default(autoincrement())
  name   String @unique
  types  String // comma-separated types
  sprite String
}
